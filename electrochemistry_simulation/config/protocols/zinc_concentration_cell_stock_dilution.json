    {"step_id": "03_dispense_low_stock", "action": "dispense", "target": "left_half_cell"},
    {"step_id": "04_discard_stock_tip", "action": "discard_tip"},
    {"step_id": "05_load_water_tip", "action": "load_tip"},
    {"step_id": "06_aspirate_water", "action": "aspirate", "source": "water", "volume_ul": 900.0},
    {"step_id": "07_dispense_water", "action": "dispense", "target": "left_half_cell"},
    {"step_id": "08_discard_water_tip", "action": "discard_tip"},
    {"step_id": "09_mix_left", "action": "mix", "target": "left_half_cell"},
